@{
    ViewBag.Title = L["Page not found"];
}

<partial name="Sections/_PageBanner" model="@(new PageBanner(L["Page Not Found"]))" />

<section class="vl-error-sec pt-100 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <div class="vl-error-con">
                    <p class="nb-error-code">404</p>
                    <div class="vl-error-text">
                        <h3 class="vl-fs-40 vl-lineheight-40 vl-text-cmn-blck pb-20 m-0">@L["Sorry, we couldn't find that page."]</h3>
                        <p class="vl-text-para vl-fs-18 vl-lineheight-28 pb-30 m-0">@L["It may have moved, or the link may be wrong. These might help:"]</p>
                    </div>
                    <div class="nb-btn-row justify-content-center">
                        <div class="vl-herobtn vl-aboutbtn vl-upper">
                            <a href="@L.Url("/")" class="theme-btn theme-btn2">@L["Back to home"] <span><i class="fa-regular fa-arrow-right"></i></span></a>
                        </div>
                        <a href="@L.Url("/services")" class="nb-text-link">@L["Our services"]</a>
                        <a href="@L.Url("/contact")" class="nb-text-link">@L["Contact us"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
