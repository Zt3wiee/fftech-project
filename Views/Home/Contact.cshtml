@model ContactForm
@{
    var site = Content.Site;
    ViewBag.Title = L["Contact us"];
    ViewBag.Description = L["Tell {0} about your project. We reply within one working day and are happy to sign your NDA first.", site.Name];
    ViewBag.HideCta = true;
    bool sent = ViewBag.Sent ?? false;
}

<partial name="Sections/_PageBanner" model="@(new PageBanner(L["Let's Talk About Your Project"], L["We reply within one working day, and we're happy to sign your NDA before the first call."]))" />

<!--================= Contact section start =================-->
<section class="vl-contact-iner pt-100 pb-70">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <div class="vl-contact-iner-box br-8 vl-gray-bg-4 mb-30" id="contact-form">
                    @if (sent)
                    {
                        <div class="nb-form-success" role="status">
                            <span class="nb-feature-icon"><i class="fa-regular fa-circle-check"></i></span>
                            <h3 class="vl-fs-24 vl-lineheight-24 vl-text-cmn-blck pb-16 m-0">@L["Thank you, your message has been sent."]</h3>
                            <p class="vl-text-para vl-fs-18 vl-lineheight-28 m-0">@L["We'll reply to you within one working day. If it's urgent, email us at"] <a href="mailto:@site.Email">@site.Email</a>.</p>
                        </div>
                    }
                    else
                    {
                        <h3 class="vl-fs-24 vl-lineheight-24 vl-text-cmn-blck pb-20 m-0">@L["Send us a message"]</h3>
                        <p class="vl-text-para vl-fs-18 vl-lineheight-28 pb-30 m-0">@L["Tell us a little about what you're building. A few sentences is enough to start."]</p>
                        <form method="post" action="@L.Url("/contact")#contact-form" asp-antiforgery="true" class="vl-contact-iner-form nb-form" novalidate>
                            <div asp-validation-summary="ModelOnly" class="nb-form-error"></div>
                            <div class="row">
                                <div class="col-md-6 mb-20">
                                    <label asp-for="Name">@L["Your name *"]</label>
                                    <input asp-for="Name" autocomplete="name">
                                    <span asp-validation-for="Name" class="nb-field-error"></span>
                                </div>
                                <div class="col-md-6 mb-20">
                                    <label asp-for="Company">@L["Company"]</label>
                                    <input asp-for="Company" autocomplete="organization">
                                </div>
                                <div class="col-md-6 mb-20">
                                    <label asp-for="Email">@L["Work email *"]</label>
                                    <input asp-for="Email" type="email" autocomplete="email">
                                    <span asp-validation-for="Email" class="nb-field-error"></span>
                                </div>
                                <div class="col-md-6 mb-20">
                                    <label asp-for="Phone">@L["Phone"]</label>
                                    <input asp-for="Phone" type="tel" autocomplete="tel">
                                </div>
                                <div class="col-12 mb-20">
                                    <label asp-for="Topic">@L["What can we help with?"]</label>
                                    <select asp-for="Topic">
                                        <option value="">@L["Choose a topic (optional)"]</option>
                                        @* Topics are stored in English so every message reads the same, whatever the page language. *@
                                        @foreach (var service in Content.Services)
                                        {
                                            var english = Content.EnglishServices.FirstOrDefault(s => s.Slug == service.Slug)?.Title ?? service.Title;
                                            <option value="@english">@service.Title</option>
                                        }
                                        <option value="Something else">@L["Something else"]</option>
                                    </select>
                                </div>
                                <div class="col-12 mb-20">
                                    <label asp-for="Message">@L["Your project *"]</label>
                                    <textarea asp-for="Message" rows="6" placeholder="@L["What are you building, and where do you need help?"]"></textarea>
                                    <span asp-validation-for="Message" class="nb-field-error"></span>
                                </div>
                                <div class="nb-hp" aria-hidden="true">
                                    <label asp-for="Website">Leave this field empty</label>
                                    <input asp-for="Website" tabindex="-1" autocomplete="off">
                                </div>
                                <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-3">
                                    <p class="nb-form-note m-0">@L["We only use your details to reply to you."]</p>
                                    <div class="vl-about-inner-btn">
                                        <button type="submit" class="vl-iner-btn">@L["Send message"] <span><i class="fa-light fa-arrow-right"></i></span></button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="vl-contact-iner-widget ml-lg-30 mb-30">
                    <div class="vl-contact-iner-widget-1 vl-gray-bg-4 br-8 mb-20">
                        <div class="vl-contact-iner-widget-1-icon mr-16">
                            <span><img src="~/img/icons/vl-contact-iner-mail.svg" alt=""></span>
                        </div>
                        <div class="vl-contact-iner-widget-1-content">
                            <h5 class="vl-contact-iner-widget-1-content-title pb-14 m-0">@L["Email us"]</h5>
                            <a href="mailto:@site.Email">@site.Email</a>
                        </div>
                    </div>
                    @foreach (var office in site.Offices)
                    {
                        <div class="vl-contact-iner-widget-1 vl-gray-bg-4 br-8 mb-20">
                            <div class="vl-contact-iner-widget-1-icon mr-16">
                                <span><img src="~/img/icons/vl-contact-iner-location.svg" alt=""></span>
                            </div>
                            <div class="vl-contact-iner-widget-1-content">
                                <h5 class="vl-contact-iner-widget-1-content-title pb-14 m-0">@office.Label</h5>
                                <p class="m-0">@office.Address</p>
                                <a href="tel:@office.Phone.Replace(" ", "")">@office.Phone</a>
                            </div>
                        </div>
                    }
                    <div class="vl-contact-iner-widget-1 vl-gray-bg-4 br-8 mb-20">
                        <div class="vl-contact-iner-widget-1-icon mr-16">
                            <span><img src="~/img/icons/vl-contact-iner-phone.svg" alt=""></span>
                        </div>
                        <div class="vl-contact-iner-widget-1-content">
                            <h5 class="vl-contact-iner-widget-1-content-title pb-14 m-0">@L["Office hours"]</h5>
                            <p class="m-0">@site.Hours</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--================= Contact section End =================-->

<div class="vl-contact-iner-map pb-100">
    <div class="container">
        <div class="row">
            @foreach (var office in site.Offices.Where(o => !string.IsNullOrEmpty(o.MapEmbedUrl)))
            {
                <div class="col-md-6">
                    <h4 class="nb-map-title">@office.City</h4>
                    <iframe src="@office.MapEmbedUrl" title="@L["Map of our {0} office", office.City]" class="vl-contact-iner-google-map nb-map mb-30 br-8" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen=""></iframe>
                </div>
            }
        </div>
    </div>
</div>
