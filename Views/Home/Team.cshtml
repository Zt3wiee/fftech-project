@{
    ViewBag.Title = L["Team"];
}

<partial name="Sections/_PageBanner" model="@(new PageBanner(L["Our Team"], L["Senior engineers and delivery leads across Taipei and Hong Kong."], new Link(L["About"], "/about")))" />

<section class="pt-100 pb-70">
    <div class="container">
        <div class="row">
            @foreach (var member in Content.Team)
            {
                <div class="col-lg-3 col-md-6">
                    <partial name="Sections/_TeamCard" model="member" />
                </div>
            }
        </div>
    </div>
</section>
