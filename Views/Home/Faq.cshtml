@{
    ViewBag.Title = "FAQ";
    var groups = Content.Faq.GroupBy(f => f.Category).ToList();
}

<partial name="Sections/_PageBanner" model="@(new PageBanner("Frequently Asked Questions", "How we work, how we price, and what to expect."))" />

<section class="vl-faq-iner pt-100 pb-70">
    <div class="container">
        @foreach (var group in groups)
        {
            <div class="mb-40">
                <h3 class="vl-fs-32 vl-lineheight-32 vl-text-cmn-blck pb-24 m-0">@group.Key</h3>
                <partial name="Sections/_Faq" model="group" />
            </div>
        }
        <p class="vl-text-para vl-fs-18 text-center">Still have a question? <a class="nb-text-link" href="/contact">Ask us directly <i class="fa-regular fa-arrow-right"></i></a></p>
    </div>
</section>
