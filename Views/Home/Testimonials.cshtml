@{
    ViewBag.Title = L["Testimonials"];
}

<partial name="Sections/_PageBanner" model="@(new PageBanner(L["What Our Clients Say"], L["Feedback from engineering and product leaders we work with."], new Link(L["About"], "/about")))" />

<section class="nb-dark-section vl-testimonial-bg-2 pt-100 pb-70">
    <div class="container">
        <div class="row">
            @foreach (var testimonial in Content.Testimonials)
            {
                <div class="col-lg-4 col-md-6 mb-30">
                    <partial name="Sections/_TestimonialCard" model="testimonial" />
                </div>
            }
        </div>
    </div>
</section>
