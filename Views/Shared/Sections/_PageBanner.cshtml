@model PageBanner
<!--================= Banner section start =================-->
<section class="vl-breadcrumb-bg nb-page-banner p-relative z-index-1 fix pt-200 pb-100" style="background-image: url(/img/nb/banner-bg.svg);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-8 col-lg-9">
                <div class="vl-breadcrumb">
                    <div class="vl-breadcrumb-list mb-20">
                        <span><a href="/">Home</a></span>
                        @foreach (var crumb in Model.Crumbs)
                        {
                            <span class="dvir"><i class="fa-solid fa-angle-right"></i></span>
                            <span><a href="@crumb.Url">@crumb.Label</a></span>
                        }
                        <span class="dvir"><i class="fa-solid fa-angle-right"></i></span>
                        <span class="active">@Model.Title</span>
                    </div>
                    <h1 class="vl-fs-60 vl-white">@Model.Title</h1>
                    @if (!string.IsNullOrEmpty(Model.Text))
                    {
                        <p class="nb-page-banner-text pt-16">@Model.Text</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!--================= Banner section End =================-->
