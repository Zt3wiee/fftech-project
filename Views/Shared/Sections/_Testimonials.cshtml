@{
    var testimonials = Content.Testimonials;
}
@if (testimonials.Count > 0)
{
    <!--================= Testimonial section start =================-->
    <section class="vl-testimonial vl-testimonial-bg-2 nb-dark-section pt-100 pb-100">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4">
                    <div class="vl-testimonial-2 mb-30" data-aos="fade-up" data-aos-duration="900">
                        <div class="vl-section-title-wrapper">
                            <h4 class="vl-section-subtitle-5 vl-white vl-upper">@L["What clients say"]</h4>
                            <h2 class="vl-section-title vl-white pt-16 pb-16">@L["Trusted by Technical Teams"]</h2>
                            <p class="desc-4 pb-32">@L["Engineering leaders in Taiwan and Hong Kong on working with us."]</p>
                        </div>
                        <div class="vl-testimonialbtn-2">
                            <div class="vl-herobtn">
                                <a href="@L.Url("/testimonials")" class="theme-btn vl-upper">@L["All testimonials"]<span><i class="fa-regular fa-arrow-right"></i></span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div id="testimoni1" class="owl-carousel owl-theme">
                        @foreach (var t in testimonials)
                        {
                            <partial name="Sections/_TestimonialCard" model="t" />
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--================= Testimonial section End =================-->
}
