<!DOCTYPE html>

@{
    var html_attributes = ViewBag.HTMLAttributes != null ? ViewBag.HTMLAttributes : "";
    var body_class = ViewBag.BodyClass != null ? ViewBag.BodyClass : "";
}

<html lang="en" @html_attributes>

<head>
    @await Html.PartialAsync("~/Views/Shared/Partials/_PageMeta.cshtml")
    @RenderSection("styles", false)
    @await Html.PartialAsync("~/Views/Shared/Partials/_HeadCSS.cshtml")
</head>

<body class="@body_class">

    @await Html.PartialAsync("~/Views/Shared/Partials/_Loader.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_NavBar.cshtml")

    @RenderBody()

    @await Html.PartialAsync("~/Views/Shared/Partials/_Footer.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_BackToTop.cshtml")
    @await Html.PartialAsync("~/Views/Shared/Partials/_FooterScripts.cshtml")
    @RenderSection("scripts", required: false)

</body>

</html>