@{
    var site = Content.Site;
}
<!--================= Footer section start =================-->
<footer>
    <section class="vl-footer vl-gray-bg-4 pt-240">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-30">
                    <div class="vl-footer-widget-1">
                        <div class="vl-footer-logo nb-logo nb-logo-dark">
                            <a href="@L.Url("/")"><img src="~/img/logo/logo-full.png" alt="@site.Name"></a>
                        </div>
                        <div class="vl-footer-content vl-footer-content-4">
                            <p class="pt-16 pb-32">@site.FooterBlurb</p>
                        </div>
                        <div class="vl-footer-social vl-footer-social-4">
                            <ul>
                                @foreach (var social in site.Social)
                                {
                                    <li><a href="@social.Url" aria-label="@social.Network"><i class="fa-brands @social.Icon"></i></a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-30">
                    <div class="vl-footer-widget-2">
                        <h3 class="vl-footer-widget-title vl-fs-20 mb-20">@L["Company"]</h3>
                        <div class="vl-footer-menu vl-footer-menu-4">
                            <ul>
                                <li><a href="@L.Url("/about")">@L["About us"]</a></li>
                                @if (Content.Work.Count > 0)
                                {
                                    <li><a href="@L.Url("/work")">@L["Our work"]</a></li>
                                }
                                @if (Content.Insights.Count > 0)
                                {
                                    <li><a href="@L.Url("/insights")">@L["Insights"]</a></li>
                                }
                                <li><a href="@L.Url("/faq")">@L["FAQ"]</a></li>
                                <li><a href="@L.Url("/contact")">@L["Contact"]</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-30">
                    <div class="vl-footer-widget-3">
                        <h3 class="vl-footer-widget-title vl-fs-20 mb-20">@L["Services"]</h3>
                        <div class="vl-footer-menu vl-footer-menu-4">
                            <ul>
                                @foreach (var service in Content.Services)
                                {
                                    <li><a href="@L.Url($"/services/{service.Slug}")">@service.Title</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-30">
                    <div class="vl-footer-widget-4">
                        <h3 class="vl-footer-widget-title vl-fs-20 mb-20">@L["Get in touch"]</h3>
                        <ul class="nb-footer-contact">
                            <li><i class="fa-regular fa-envelope"></i><a href="mailto:@site.Email">@site.Email</a></li>
                            @* Offices whose phone number is still "TBD" are left out of the footer until there is a real number. *@
                            @foreach (var office in site.Offices.Where(o => o.Phone != "TBD"))
                            {
                                <li><i class="fa-regular fa-location-dot"></i><span><strong>@office.City</strong><br><a href="tel:@office.Phone.Replace(" ", "")">@office.Phone</a></span></li>
                            }
                            <li><i class="fa-regular fa-clock"></i><span>@site.Hours</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="vl-footer-border-top">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="vl-footer-copyright-text vl-footer-copyright-text-4">
                            <p>&copy;@DateTime.Now.Year @site.Name. @L["All rights reserved."]</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="vl-footer-copyright-menu">
                            <ul>
                                <li><span>@site.Tagline</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</footer>
<!--================= Footer section End =================-->
