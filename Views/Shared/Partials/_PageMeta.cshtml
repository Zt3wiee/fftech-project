@{
    var site = Content.Site;
    string? pageTitle = ViewBag.Title;
    var title = string.IsNullOrEmpty(pageTitle) ? $"{site.Name} | {site.Tagline}" : $"{pageTitle} | {site.Name}";
    string description = ViewBag.Description ?? site.MetaDescription;
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var url = origin + L.UrlFor(L.Language, includeQuery: false);
}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>@title</title>
<meta name="description" content="@description">
<link rel="canonical" href="@url">

<!-- the same page in the other languages, for search engines -->
@foreach (var language in Languages.All)
{
    <link rel="alternate" hreflang="@language.HtmlLang" href="@(origin + L.UrlFor(language, includeQuery: false))">
}
<link rel="alternate" hreflang="x-default" href="@(origin + L.UrlFor(Languages.English, includeQuery: false))">

<!-- link previews (LinkedIn, Facebook, LINE, WhatsApp) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="@site.Name">
<meta property="og:title" content="@title">
<meta property="og:description" content="@description">
<meta property="og:url" content="@url">
<meta property="og:locale" content="@L.Language.Culture.Replace('-', '_')">
<meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/logo/logo.png")">
<meta name="theme-color" content="#050B2E">

<!-- fav icon -->
<link rel="icon" href="~/img/icons/favicon.ico" sizes="any">
<link rel="icon" type="image/png" href="~/img/icons/favicon.png">
<link rel="apple-touch-icon" href="~/img/icons/apple-touch-icon.png">
