@{
    var site = Content.Site;
}
<!--================= Header section start =================-->
<header>
    <div id="vl-header-sticky" class="vl-header-area vl-transparent-header vl-transparent-header-4">
        <div class="container vl-header-bg-4">
            <div class="row align-items-center">
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="vl-logo nb-logo">
                        <a href="/"><img src="~/img/logo/logo.png" alt="@site.Name"><span>@site.ShortName</span></a>
                    </div>
                </div>
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="vl-main-menu text-center">
                        <nav class="vl-mobile-menu-active">
                            <ul>
                                <li class="has-dropdown">
                                    <a href="/services">Services <span><i class="fa-regular fa-angle-down"></i></span></a>
                                    <ul class="sub-menu">
                                        <li><a href="/services">All services</a></li>
                                        @foreach (var service in Content.Services)
                                        {
                                            <li><a href="/services/@service.Slug">@service.Title</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="has-dropdown">
                                    <a href="/industries">Industries <span><i class="fa-regular fa-angle-down"></i></span></a>
                                    <ul class="sub-menu">
                                        <li><a href="/industries">All industries</a></li>
                                        @foreach (var industry in Content.Industries)
                                        {
                                            <li><a href="/industries/@industry.Slug">@industry.Title</a></li>
                                        }
                                    </ul>
                                </li>
                                @if (Content.Work.Count > 0)
                                {
                                    <li><a href="/work">Work</a></li>
                                }
                                <li class="has-dropdown">
                                    <a href="/about">About <span><i class="fa-regular fa-angle-down"></i></span></a>
                                    <ul class="sub-menu">
                                        <li><a href="/about">About us</a></li>
                                        @if (Content.Team.Count > 0)
                                        {
                                            <li><a href="/team">Team</a></li>
                                        }
                                        @if (Content.Testimonials.Count > 0)
                                        {
                                            <li><a href="/testimonials">Testimonials</a></li>
                                        }
                                        <li><a href="/faq">FAQ</a></li>
                                    </ul>
                                </li>
                                @if (Content.Insights.Count > 0)
                                {
                                    <li><a href="/insights">Insights</a></li>
                                }
                                <li><a href="/contact">Contact</a></li>
                            </ul>
                        </nav>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <div class="vl-herobtn d-none d-lg-block fl-right">
                        <a href="/contact" class="theme-btn">Get started <span><i class="fa-regular fa-arrow-right"></i></span></a>
                    </div>

                    <div class="vl-header-action-item d-block d-lg-none">
                        <button type="button" class="vl-offcanvas-toggle" aria-label="Open menu">
                            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="16" viewBox="0 0 30 16">
                                <rect x="10" width="20" height="2" fill="currentColor"></rect>
                                <rect x="5" y="7" width="25" height="2" fill="currentColor"></rect>
                                <rect x="10" y="14" width="20" height="2" fill="currentColor"></rect>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- offcanvas menu start -->
<div class="vl-offcanvas vl-offcanvas-bg-1">
    <div class="vl-offcanvas-wrapper">
        <div class="vl-offcanvas-header d-flex justify-content-between align-items-center mb-50">
            <div class="vl-offcanvas-logo nb-logo">
                <a href="/"><img src="~/img/logo/logo.png" alt="@site.Name"><span>@site.ShortName</span></a>
            </div>
            <div class="vl-offcanvas-close">
                <button class="vl-offcanvas-close-toggle" aria-label="Close menu"><i class="fal fa-times"></i></button>
            </div>
        </div>

        <div class="vl-offcanvas-menu d-lg-none mb-40">
            <nav></nav>
        </div>

        <div class="vl-offcanvas-btnm text-center mb-30">
            <div class="vl-herobtn vl-aboutbtn w-100 vl-upper">
                <a href="/contact" class="theme-btn theme-btn2">Get started<span><i class="fa-regular fa-arrow-right"></i></span></a>
            </div>
        </div>

        <div class="vl-offcanvas-info mb-30">
            <h3 class="vl-offcanvas-sm-title pb-15">Contact us</h3>

            @foreach (var office in site.Offices)
            {
                <div class="vl-offcanvas-info-box mb-15">
                    <div class="vl-offcanvas-info-box-icon">
                        <span><img src="~/img/icons/vl-contact-iner-phone.svg" alt=""></span>
                    </div>
                    <div class="vl-offcanvas-info-box-text">
                        <span><a href="tel:@office.Phone.Replace(" ", "")">@office.City: @office.Phone</a></span>
                    </div>
                </div>
            }

            <div class="vl-offcanvas-info-box mb-15">
                <div class="vl-offcanvas-info-box-icon">
                    <span><img src="~/img/icons/vl-contact-iner-mail.svg" alt=""></span>
                </div>
                <div class="vl-offcanvas-info-box-text">
                    <span><a href="mailto:@site.Email">@site.Email</a></span>
                </div>
            </div>
        </div>

        <div class="vl-offcanvas-social mb-40">
            <h3 class="vl-offcanvas-sm-title mb-15">Follow us</h3>
            @foreach (var social in site.Social)
            {
                <a href="@social.Url" aria-label="@social.Network"><i class="fab @social.Icon"></i></a>
            }
        </div>

    </div>
</div>
<div class="vl-offcanvas-overlay"></div>
<!-- offcanvas menu end -->
<!--================= Header section End =================-->
