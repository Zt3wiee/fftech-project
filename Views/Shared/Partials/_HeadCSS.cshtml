@* Fonts for the other scripts. A language's own pages load the full font; every other page loads
   only the few letters needed to show its name in the language switcher. *@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
@switch (L.Language.Code)
{
    case "km":
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300..700&display=swap">
        break;
    case "vi":
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap">
        break;
    case "zh-tw":
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300..800&display=swap">
        break;
}
@if (L.Language.Code != "km")
{
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@500;700&text=%E1%9E%97%E1%9E%B6%E1%9E%9F%E1%9E%B6%E1%9E%81%E1%9F%92%E1%9E%98%E1%9F%82%E1%9E%9A&display=swap">
}
@if (L.Language.Code != "vi")
{
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@500;700&text=Ti%E1%BA%BFng%20Vi%E1%BB%87t&display=swap">
}
