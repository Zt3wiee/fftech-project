@{
    ViewBag.Title = L["Services"];
    ViewBag.Description = L["Custom software, cloud migration, manufacturing software, data & AI, fintech systems and dedicated engineering teams for technology companies in Taiwan and Hong Kong."];
}

<partial name="Sections/_PageBanner" model="@(new PageBanner(L["Our Services"], L["End-to-end software engineering for technology companies, from a single project to a long-term dedicated team."]))" />

<section class="vl-service-area pt-100 pb-70">
    <div class="container">
        <partial name="Sections/_ServiceCards" model="Content.Services" />
    </div>
</section>

<!--================= Engagement models start =================-->
<section class="vl-gray-bg-4 pt-100 pb-70">
    <div class="container">
        <div class="vl-section-title-wrapper text-center mb-60">
            <h4 class="vl-section-subtitle-7 vl-upper">@L["How we engage"]</h4>
            <h2 class="vl-section-title vl-section-title-2 pt-16">@L["Three Ways to Work With Us"]</h2>
        </div>
        <partial name="Sections/_FeatureGrid" model="Content.Site.EngagementModels" />
        <p class="vl-text-para vl-fs-18 text-center pt-10">@L["Not sure which fits?"] <a class="nb-text-link" href="@L.Url("/contact")">@L["Tell us about your project"] <i class="fa-regular fa-arrow-right"></i></a></p>
    </div>
</section>
<!--================= Engagement models end =================-->

<partial name="Sections/_Process" />
